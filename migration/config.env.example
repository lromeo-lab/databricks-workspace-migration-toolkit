# =============================================================================
# config.env — SINGLE source of truth for the whole migration.
# Create/edit this file identically in THREE places:
#   1) your local laptop terminal (used by bin/10_local_setup.sh)
#   2) the SOURCE workspace web terminal (used by bin/20_source_package.sh)
#   3) the DEST workspace web terminal   (used by bin/30_dest_clone.sh, bin/40_dest_land.sh)
# Only fill the values; the scripts read everything from here.
#
# IMPORTANT (ephemeral mode): bin/10_local_setup.sh WRITES back RUN_ID,
# SRC_CRED_ID and DST_CRED_ID into this file. After running phase 10, copy the
# UPDATED config.env to the two web terminals before running phases 20/30.
# =============================================================================

# ---- Remote Git repository (shared by every phase) -------------------------
export GIT_URL="https://github.com/<your-org>/<migration-repository>.git"
export GIT_BRANCH="main"                       # everything stays on main
export GIT_AUTHOR_NAME="Lucas Romeo"
export GIT_AUTHOR_EMAIL="lucas.romeo@databricks.com"

# ---- Git provider credential (LOCAL laptop only) ---------------------------
export GIT_PROVIDER="gitHub"                   # gitHub | gitLab | azureDevOpsServices | bitbucketCloud
export GIT_USERNAME="<git-username>"
export GIT_EMAIL="<git-email>"

# ---- Databricks CLI (LOCAL laptop only) ------------------------------------
export SRC_WS_URL="https://<source-workspace-host>"
export DST_WS_URL="https://<destination-workspace-host>"

# ---- Git worktree staging location (WORKSPACE web terminals) ---------------
# Same value works in both workspaces when the user path is the same.
export GIT_STAGING_PARENT="/Workspace/Users/lucas.romeo@databricks.com/git-migration"
export GIT_WORKTREE="$GIT_STAGING_PARENT/migration-repo"

# =============================================================================
# EPHEMERAL MODE — temporary, collision-free profiles + Git credentials that
# are created for this run and torn down automatically. This keeps reruns clean
# and minimizes how long your PAT is stored server-side as a Git credential.
# =============================================================================
export EPHEMERAL_ENABLED="true"                # "true" to use ephemeral pattern
export KEEP_EPHEMERAL="false"                  # "true" to SKIP teardown (debugging)

# Prefix for the temporary LOCAL CLI profiles. Final names are collision-free:
#   <prefix>-src-<RUN_ID>  and  <prefix>-dst-<RUN_ID>
export EPHEMERAL_PROFILE_PREFIX="mig"

# The three values below are FILLED IN AUTOMATICALLY by bin/10_local_setup.sh.
# Leave them blank on a brand-new run. After phase 10, copy this file (now
# populated) to the source and dest web terminals.
export RUN_ID=""                               # unique id for this migration run
export SRC_CRED_ID=""                          # source workspace Git credential id
export DST_CRED_ID=""                          # dest workspace Git credential id
